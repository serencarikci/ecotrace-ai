APP_NAME=EcoTrace AI
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.7.1
SECRET_KEY=replace-with-a-long-random-secret-at-least-48-characters
INITIAL_ADMIN_PASSWORD=replace-with-strong-password
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com,api.example.com
ENABLE_HSTS=true
PUBLIC_APP_BASE_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://api.example.com
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecotrace
POSTGRES_USER=ecotrace
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql+psycopg://ecotrace:replace-with-strong-db-password@postgres:5432/ecotrace
ATTACHMENT_STORAGE_PATH=/data/attachments
KNOWLEDGE_STORAGE_PATH=/data/knowledge
REPORT_STORAGE_PATH=/data/reports
BACKUP_STORAGE_PATH=/data/backups
SCHEDULER_ENABLED=true
AI_LLM_PROVIDER=local_grounded
AI_EMBEDDING_PROVIDER=local_hash
SMTP_ENABLED=false
ENABLE_METRICS=true
