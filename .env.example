APP_NAME=EcoTrace AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.7.1
API_V1_PREFIX=/api/v1

SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecotrace
POSTGRES_USER=ecotrace
POSTGRES_PASSWORD=ecotrace_dev_password
DATABASE_URL=postgresql+psycopg://ecotrace:ecotrace_dev_password@postgres:5432/ecotrace

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

LOG_LEVEL=INFO

INITIAL_ADMIN_EMAIL=admin@ecotrace.dev
INITIAL_ADMIN_PASSWORD=EcoTraceAdmin!2024
INITIAL_ADMIN_FULL_NAME=EcoTrace Admin

DEMO_ORG_ADMIN_EMAIL=orgadmin@ecotrace.dev
DEMO_ORG_ADMIN_PASSWORD=EcoTraceOrgAdmin!2024
DEMO_ANALYST_EMAIL=analyst@ecotrace.dev
DEMO_ANALYST_PASSWORD=EcoTraceAnalyst!2024
DEMO_VIEWER_EMAIL=viewer@ecotrace.dev
DEMO_VIEWER_PASSWORD=EcoTraceViewer!2024
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=4200

ATTACHMENT_STORAGE_PATH=/data/attachments
MAX_ATTACHMENT_SIZE_MB=10
MAX_CSV_IMPORT_ROWS=5000
ALLOWED_ATTACHMENT_TYPES=pdf,csv,xlsx,png,jpeg,jpg
